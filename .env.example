# Greentryst local environment template.
# Copy to .env.local and fill in. Never commit .env.local.
# All values below are placeholders.

# ── Clerk (auth) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Turso (libSQL) ───────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=eyJ...

# ── Groq (LLM Governor) ──────────────────────────────────────────────────────
# Comma-separated list is preferred; single key also works.
GROQ_API_KEYS=gsk_key1,gsk_key2
# GROQ_API_KEY=gsk_fallback

# ── Voyage AI (embeddings) ───────────────────────────────────────────────────
VOYAGE_API_KEY=pa-...

# ── SustainIQ / ASK server (HF Space) ────────────────────────────────────────
ASK_SERVER_URL=https://your-space.hf.space
ASK_SERVER_TOKEN=shared_bearer_token_for_hf_space

# ── Resume pipeline ──────────────────────────────────────────────────────────
# Docling parser (HF Space).
RESUME_PARSER_URL=https://your-parser.hf.space
RESUME_PARSER_TOKEN=shared_bearer_token_for_parser
# Internal shared secret between /api/resume/upload and /api/resume/process.
# Generate a random 32+ char string. Never ship the same value across envs.
RESUME_PROCESS_TOKEN=generate_a_random_32_plus_char_token

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_RESUMES_BUCKET=greentryst-resumes
# Public R2 base URL for served PDFs (optional; falls back to default).
PDF_R2_BASE_URL=https://pub-your-hash.r2.dev

# ── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Sentry (error reporting) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
